<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Product>SimpleDMS</Product>
    <Authors>Bohdan Koudelka</Authors>
    <Copyright>Copyright © 2026 Bohdan Koudelka</Copyright>
    <RepositoryUrl>https://github.com/KoudelkaB/SimpleDMS</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerDefaultPreReleaseIdentifiers>alpha.0</MinVerDefaultPreReleaseIdentifiers>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="MinVer" Version="7.0.0" PrivateAssets="All" /></ItemGroup>
</Project>
